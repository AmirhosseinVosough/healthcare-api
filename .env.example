# Copy to .env and fill in. The app refuses to start without a real JWT_SECRET.

DATABASE_URL=postgresql+asyncpg://healthcare:healthcare@localhost:5433/healthcare
REDIS_URL=redis://localhost:6379/0

# Generate with:  openssl rand -hex 32   (must be 32+ bytes)
JWT_SECRET=
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password hashing cost. 12 is the production default; tests drop it to 4.
BCRYPT_ROUNDS=12

# --- rate limiting -----------------------------------------------------------
RATE_LIMIT_ENABLED=true
# Per caller, per minute, on login/signup/refresh.
AUTH_RATE_LIMIT=5
AUTH_RATE_WINDOW_SECONDS=60
# Per account, failed logins only, over this window.
ACCOUNT_RATE_LIMIT=10
ACCOUNT_RATE_WINDOW_SECONDS=900

# Addresses of proxies allowed to set X-Forwarded-For, comma-separated.
# EMPTY = trust nobody (the safe default). Only ever list a proxy address that
# outside clients cannot themselves connect from. See docs/deploy.md.
TRUSTED_PROXY_IPS=

# Number of worker processes. Read note 2 in docs/deploy.md before raising it:
# (pool_size + max_overflow) x this must stay under the database's limit.
WEB_CONCURRENCY=1
